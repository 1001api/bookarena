package views

templ DashboardPage() {
	@Layout("Dashboard") {
		<body
			x-data="dashboard"
			class="bg-gray-900 min-h-screen bg-gradient-to-r from-secondary to-third text-gray-900 dark:text-white"
		>
			<main class="max-w-5xl mx-auto px-4 py-12">
				<!-- Header -->
				<div class="flex items-center justify-between mb-8">
					<div>
						<h1 class="text-3xl font-bold">Field Dashboard</h1>
						<p class="text-sm text-gray-600 dark:text-gray-400">Field Dashboard</p>
					</div>
					<a
						href="/logout"
						class="bg-red-600 hover:bg-red-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition"
					>
						Logout
					</a>
				</div>
				<!-- Loading Spinner -->
				<div x-show="loading" class="flex justify-center items-center py-20">
					<svg aria-hidden="true" class="w-8 h-8 text-gray-200 animate-spin fill-blue-600" viewBox="0 0 100 101">
						<path d="M100 50.5908C100 78.2051 77.6142..." fill="currentColor"></path>
						<path d="M93.9676 39.0409C96.393 38.4038..." fill="currentFill"></path>
					</svg>
				</div>
				<!-- Field List -->
				<div x-show="!loading && fields.length" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
					<template x-for="field in fields" :key="field.id">
						<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-md p-6 border border-gray-200 dark:border-gray-700 flex flex-col justify-between">
							<img :src="field.image" class="w-full h-48 object-cover rounded-t-2xl" alt="Field Image"/>
							<div>
								<h2 class="text-xl font-semibold mb-2" x-text="field.name"></h2>
								<p class="text-sm text-gray-600 dark:text-gray-400 mb-2">
									Type: <span x-text="field.type"></span>
								</p>
								<p class="text-sm text-gray-600 dark:text-gray-400">
									Price/hour: <span class="font-semibold text-blue-500" x-text="formatPrice(field.price_per_hour)"></span>
								</p>
							</div>
							<div class="mt-4">
								<a
									:href="`/d/${field.id}`"
									class="inline-block w-full text-center bg-blue-600 hover:bg-blue-700 text-white font-medium py-2.5 rounded-lg transition"
								>
									View Details
								</a>
							</div>
						</div>
					</template>
				</div>
				<!-- Empty State -->
				<div x-show="!loading && !fields.length" class="text-center py-20 text-gray-400">
					No fields found.
				</div>
			</main>
			<script>
			document.addEventListener("alpine:init", () => {
				Alpine.data("dashboard", () => ({
					fields: [],
					loading: true,

					async init() {
						try {
							const res = await fetch("/api/v1/fields/list", {
                                credentials: "include"
                            })

							const data = await res.json()

							if (res.ok && data.data) {
								this.fields = data.data
							} 

                            console.log(data, res.status)

                            if (res.status === 401) {
                                window.location.href = "/login"
                            }
						} catch (err) {
							console.error("Failed to fetch fields:", err)
						} finally {
							this.loading = false
						}
					},

					formatPrice(price) {
						return price ? `Rp ${price.toLocaleString('id-ID')}` : "Free"
					}
				}))
			})
			</script>
		</body>
	}
}
